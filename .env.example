# Copy this file to ".env" (same folder) and fill in your own values.
# Never commit the real .env file.

# ---------- MySQL ----------
DB_URL=jdbc:mysql://localhost:3306/examsphere?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change_me

# ---------- JWT ----------
# Any long random string (32+ characters). Example generator: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string
# Token lifetime in milliseconds (7200000 = 2 hours)
JWT_EXPIRATION=7200000

# ---------- SMTP (needed for real email verification / password reset) ----------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=ExamSphere <no-reply@example.com>
MAIL_PROTOCOL=smtp
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Local development only: if SMTP is empty and this is true, the verification /
# reset link is printed in the backend console instead of being emailed.
APP_DEV_LOG_EMAIL_LINKS=false

# ---------- Frontend ----------
# Where the UI is opened from. Used for links inside emails and for CORS.
# Several origins can be comma-separated; the first one is used in emails.
FRONTEND_URL=http://localhost:8080

# ---------- Misc ----------
SERVER_PORT=8080
APP_SEED_ENABLED=true
DB_DDL_AUTO=update
